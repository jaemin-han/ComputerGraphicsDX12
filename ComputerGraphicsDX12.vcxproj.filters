<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Filter Include="Application" />
    <Filter Include="Renderer" />
    <Filter Include="Resources" />
    <Filter Include="Common" />
    <Filter Include="Shaders" />
    <Filter Include="Assets" />
    <Filter Include="Configuration" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\main.cpp">
      <Filter>Application</Filter>
    </ClCompile>
    <ClCompile Include="src\Camera.cpp">
      <Filter>Renderer</Filter>
    </ClCompile>
    <ClCompile Include="src\Engine.cpp">
      <Filter>Renderer</Filter>
    </ClCompile>
    <ClCompile Include="src\FrameResource.cpp">
      <Filter>Renderer</Filter>
    </ClCompile>
    <ClCompile Include="src\Geometry.cpp">
      <Filter>Resources</Filter>
    </ClCompile>
    <ClCompile Include="src\Mesh.cpp">
      <Filter>Resources</Filter>
    </ClCompile>
    <ClCompile Include="src\Pipeline.cpp">
      <Filter>Renderer</Filter>
    </ClCompile>
    <ClCompile Include="src\Texture.cpp">
      <Filter>Resources</Filter>
    </ClCompile>
    <ClCompile Include="src\Util.cpp">
      <Filter>Common</Filter>
    </ClCompile>
    <ClCompile Include="src\Window.cpp">
      <Filter>Application</Filter>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\Camera.h">
      <Filter>Renderer</Filter>
    </ClInclude>
    <ClInclude Include="src\ConstantBuffers.h">
      <Filter>Renderer</Filter>
    </ClInclude>
    <ClInclude Include="src\Engine.h">
      <Filter>Renderer</Filter>
    </ClInclude>
    <ClInclude Include="src\FrameResource.h">
      <Filter>Renderer</Filter>
    </ClInclude>
    <ClInclude Include="src\Geometry.h">
      <Filter>Resources</Filter>
    </ClInclude>
    <ClInclude Include="src\Mesh.h">
      <Filter>Resources</Filter>
    </ClInclude>
    <ClInclude Include="src\Pipeline.h">
      <Filter>Renderer</Filter>
    </ClInclude>
    <ClInclude Include="src\Texture.h">
      <Filter>Resources</Filter>
    </ClInclude>
    <ClInclude Include="src\Util.h">
      <Filter>Common</Filter>
    </ClInclude>
    <ClInclude Include="src\Window.h">
      <Filter>Application</Filter>
    </ClInclude>
  </ItemGroup>
  <ItemGroup>
    <None Include=".clang-format">
      <Filter>Configuration</Filter>
    </None>
    <None Include="shaders\Common.hlsli">
      <Filter>Shaders</Filter>
    </None>
  </ItemGroup>
  <ItemGroup>
    <CopyFileToFolders Include="assets\textures\kloofendal_specular.dds">
      <Filter>Assets</Filter>
    </CopyFileToFolders>
    <CopyFileToFolders Include="assets\textures\kloofendal_diffuse.dds">
      <Filter>Assets</Filter>
    </CopyFileToFolders>
    <CopyFileToFolders Include="assets\textures\cobblestone_albedo.png">
      <Filter>Assets</Filter>
    </CopyFileToFolders>
  </ItemGroup>
  <ItemGroup>
    <FxCompile Include="shaders\MeshVertexShader.hlsl">
      <Filter>Shaders</Filter>
    </FxCompile>
    <FxCompile Include="shaders\RayScenePixelShader.hlsl">
      <Filter>Shaders</Filter>
    </FxCompile>
    <FxCompile Include="shaders\SkyVertexShader.hlsl">
      <Filter>Shaders</Filter>
    </FxCompile>
    <FxCompile Include="shaders\SkyPixelShader.hlsl">
      <Filter>Shaders</Filter>
    </FxCompile>
  </ItemGroup>
</Project>
